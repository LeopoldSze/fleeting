{
  "name": "fleeting",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "description": "知识",
  "author": "Leopold-Sze",
  "license": "MIT",
  "homepage": "https://github.com/LeopoldSze/fleeting#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeopoldSze/fleeting.git"
  },
  "bugs": {
    "url": "https://github.com/LeopoldSze/fleeting/issues"
  },
  "keywords": [
    "fleeting",
    "note",
    "markdown"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2",
    "pnpm": ">=11.0.0"
  },
  "volta": {
    "node": "24.0.0",
    "pnpm": "11.3.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:docs": "pnpm --filter @leopoldsze/docs dev",
    "dev:tracker-sdk": "pnpm --filter @leopoldsze/tracker-sdk dev",
    "dev:utils": "pnpm --filter @leopoldsze/utils dev",
    "build": "pnpm -r build",
    "build:docs": "pnpm --filter @leopoldsze/docs build",
    "build:tracker-sdk": "pnpm --filter @leopoldsze/tracker-sdk build",
    "build:utils": "pnpm --filter @leopoldsze/utils build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:all": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "postinstall": "simple-git-hooks",
    "commit": "czg",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/bun": "latest",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit $1",
    "pre-push": "pnpm -r typecheck"
  }
}
