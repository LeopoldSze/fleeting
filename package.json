{
  "name": "fleeting",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "知识",
  "author": "Leopold-Sze",
  "license": "MIT",
  "homepage": "https://github.com/LeopoldSze/fleeting#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeopoldSze/fleeting.git"
  },
  "bugs": {
    "url": "https://github.com/LeopoldSze/fleeting/issues"
  },
  "keywords": [
    "fleeting",
    "note",
    "markdown"
  ],
  "module": "index.ts",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.2",
    "pnpm": ">=10.15.1"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:blog": "pnpm --filter @leopoldsze/blog dev",
    "dev:docs": "pnpm --filter @leopoldsze/docs dev",
    "dev:utils": "pnpm --filter @leopoldsze/utils dev",
    "build": "pnpm -r build",
    "build:blog": "pnpm --filter @leopoldsze/blog build",
    "build:docs": "pnpm --filter @leopoldsze/docs build",
    "build:utils": "pnpm --filter @leopoldsze/utils build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:all": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "postinstall": "simple-git-hooks",
    "commit": "git-cz",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint-react/eslint-plugin": "^1.38.4",
    "@types/bun": "latest",
    "@unocss/eslint-plugin": "^66.5.2",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "eslint": "^9.37.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "eslint-plugin-svelte": "^3.12.4",
    "lint-staged": "^16.2.3",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.39.11",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit $1",
    "pre-push": "pnpm -r typecheck"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
