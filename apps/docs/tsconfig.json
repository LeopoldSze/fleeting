{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["docs/src/*"]
    },
    "types": ["bun", "vite/client", "vitepress", "vitepress/client"],
    "noEmit": true
  },
  "include": [
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.d.ts",
    "docs/**/*.ts",
    "docs/**/*.d.ts",
    "docs/**/*.tsx",
    "docs/**/*.vue",
    "index.d.ts",
    "shims-vue.d.ts"
  ],
  "exclude": [
    "node_modules",
    "docs/src/assets",
    "docs/src/public",
    "dist"
  ]
}
