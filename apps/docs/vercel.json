{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vitepress",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.doc.leopoldsze.top"
        }
      ],
      "destination": "https://doc.leopoldsze.top/:path*",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
